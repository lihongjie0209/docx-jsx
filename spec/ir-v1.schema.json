{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docx-jsx.dev/schema/ir-v1.json",
  "title": "docx-jsx IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "document"],
  "properties": {
    "version": { "const": 1 },
    "document": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "props", "children"],
      "properties": {
        "type": {
          "enum": ["Document", "Section", "Paragraph", "Run", "Text", "Break", "CarriageReturn", "NonBreakingSpace", "SoftHyphen", "NonBreakingHyphen", "Image", "Table", "TableRow", "TableCell", "Header", "Footer", "Hyperlink", "PageNumber", "TotalPages", "List", "ListItem", "Heading", "Caption", "Index", "Bookmark", "InlineBookmark", "TableOfContents", "TableOfFigures", "TableOfEntries", "TocItem", "TocBefore", "TocAfter", "TocEntry", "IndexEntry", "Comment", "Footnote", "Tab", "TabStop", "Symbol", "Bold", "Italic", "Underline", "StrikeThrough", "Superscript", "Subscript", "AllCaps", "HiddenText", "SpecialHiddenText", "DoubleStrike", "SpacedText", "ScaledText", "FitText", "BorderedText", "ShadedText", "Inserted", "Deleted", "DeletedInstruction", "MovedFrom", "MovedTo", "PageReference", "PositionalTab", "ContentControl", "Field", "DateField", "TimeField", "FileNameField", "AuthorField", "TitleField", "SubjectField", "SequenceField", "ReferenceField", "MergeField", "DocumentPropertyField", "FormulaField"]
        },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/node" }, { "type": "string" }, { "type": "number" }] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "TableRow" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/tableRowProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "TableCell" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/tableCellProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Paragraph" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/paragraphProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Heading" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/headingProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Run" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/runProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Section" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/sectionProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Document" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/documentProps" } } }
        },
        {
          "if": { "properties": { "type": { "const": "Image" } }, "required": ["type"] },
          "then": { "properties": { "props": { "$ref": "#/$defs/imageProps" } } }
        }
      ]
    },
    "tableRowProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "heightRule": { "enum": ["auto", "atLeast", "exact"] },
        "cantSplit": { "type": "boolean" },
        "header": { "type": "boolean" },
        "gridBefore": { "type": "integer", "minimum": 0 },
        "gridAfter": { "type": "integer", "minimum": 0 },
        "widthBefore": { "type": "number", "minimum": 0 },
        "widthAfter": { "type": "number", "minimum": 0 },
        "inserted": { "$ref": "#/$defs/rowRevision" },
        "deleted": { "$ref": "#/$defs/rowRevision" }
      },
      "not": { "required": ["inserted", "deleted"] }
    },
    "rowRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "tableCellProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "widthPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "colSpan": { "type": "integer", "minimum": 1 },
        "verticalAlign": { "enum": ["top", "center", "bottom"] },
        "verticalMerge": { "enum": ["restart", "continue"] },
        "textDirection": { "enum": ["lr", "lrV", "rl", "rlV", "tb", "tbV", "tbRlV", "tbRl", "btLr", "lrTbV"] },
        "noWrap": { "type": "boolean" },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          }
        },
        "shading": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "border": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] }
      },
      "not": { "required": ["width", "widthPercent"] }
    },
    "paragraphCommonProps": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "minLength": 1 },
        "align": { "enum": ["left", "center", "right", "both", "distribute", "start", "end", "justified"] },
        "spacingBefore": { "type": "number", "minimum": 0 },
        "spacingAfter": { "type": "number", "minimum": 0 },
        "lineSpacing": { "type": "number", "minimum": 0 },
        "spacingBeforeLines": { "type": "integer", "minimum": 0 },
        "spacingAfterLines": { "type": "integer", "minimum": 0 },
        "lineRule": { "enum": ["auto", "atLeast", "exact"] },
        "indentLeft": { "type": "number" },
        "indentRight": { "type": "number" },
        "indentLeftChars": { "type": "integer" },
        "indentStartChars": { "type": "integer" },
        "indentRightChars": { "type": "integer" },
        "indentEndChars": { "type": "integer" },
        "firstLine": { "type": "number", "minimum": 0 },
        "hanging": { "type": "number", "minimum": 0 },
        "firstLineChars": { "type": "integer" },
        "hangingChars": { "type": "integer" },
        "keepNext": { "type": "boolean" },
        "keepLines": { "type": "boolean" },
        "contextualSpacing": { "type": "boolean" },
        "mirrorIndents": { "type": "boolean" },
        "suppressOverlap": { "type": "boolean" },
        "pageBreakBefore": { "type": "boolean" },
        "snapToGrid": { "type": "boolean" },
        "widowControl": { "type": "boolean" },
        "suppressLineNumbers": { "type": "boolean" },
        "font": { "type": "string", "minLength": 1 },
        "fonts": { "$ref": "#/$defs/fontSlots" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "characterSpacing": { "type": "number" },
        "bidi": { "type": "boolean" },
        "textAlign": { "enum": ["auto", "baseline", "bottom", "center", "top"] },
        "adjustRightIndent": { "enum": [0, 1] },
        "shading": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "frame": { "type": "object" },
        "inserted": { "$ref": "#/$defs/paragraphRevision" },
        "deleted": { "$ref": "#/$defs/paragraphRevision" },
        "propertyChange": { "type": "object" },
        "paragraphId": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" },
        "border": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] }
      },
      "allOf": [
        { "not": { "required": ["font", "fonts"] } },
        { "not": { "required": ["inserted", "deleted"] } },
        { "not": { "required": ["indentLeftChars", "indentStartChars"] } },
        { "not": { "required": ["indentRightChars", "indentEndChars"] } },
        { "not": { "required": ["firstLine", "hanging"] } },
        { "not": { "required": ["firstLine", "hangingChars"] } },
        { "not": { "required": ["firstLineChars", "hanging"] } },
        { "not": { "required": ["firstLineChars", "hangingChars"] } }
      ]
    },
    "paragraphRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 }
      }
    },
    "paragraphProps": {
      "allOf": [
        { "$ref": "#/$defs/paragraphCommonProps" },
        { "type": "object", "properties": { "outlineLevel": { "type": "integer", "minimum": 0, "maximum": 9 } } }
      ],
      "unevaluatedProperties": false
    },
    "fontSlots": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ascii": { "type": "string", "minLength": 1 },
        "hiAnsi": { "type": "string", "minLength": 1 },
        "eastAsia": { "type": "string", "minLength": 1 },
        "cs": { "type": "string", "minLength": 1 },
        "asciiTheme": { "type": "string", "minLength": 1 },
        "hiAnsiTheme": { "type": "string", "minLength": 1 },
        "eastAsiaTheme": { "type": "string", "minLength": 1 },
        "csTheme": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    },
    "runProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "minLength": 1 },
        "fonts": { "$ref": "#/$defs/fontSlots" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "sizeCs": { "type": "number", "exclusiveMinimum": 0 },
        "bold": { "type": "boolean" },
        "boldCs": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "italicCs": { "type": "boolean" },
        "strike": { "type": "boolean" },
        "doubleStrike": { "type": "boolean" },
        "underline": {
          "oneOf": [
            { "type": "boolean" },
            { "enum": ["single", "words", "double", "thick", "dotted", "dottedHeavy", "dash", "dashedHeavy", "dashLong", "dashLongHeavy", "dotDash", "dashDotHeavy", "dotDotDash", "dashDotDotHeavy", "wave", "wavyHeavy", "wavyDouble", "none"] }
          ]
        },
        "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "highlight": { "type": "string", "minLength": 1 },
        "themeColor": { "enum": ["dark1", "light1", "dark2", "light2", "accent1", "accent2", "accent3", "accent4", "accent5", "accent6", "hyperlink", "followedHyperlink", "none", "background1", "text1", "background2", "text2"] },
        "themeShade": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}$" },
        "themeTint": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}$" },
        "verticalAlign": { "enum": ["baseline", "superscript", "subscript"] },
        "caps": { "type": "boolean" },
        "hidden": { "const": true },
        "specVanish": { "const": true }
      },
      "allOf": [
        { "not": { "required": ["font", "fonts"] } },
        {
          "not": {
            "properties": { "strike": { "const": true }, "doubleStrike": { "const": true } },
            "required": ["strike", "doubleStrike"]
          }
        }
      ]
    },
    "headingProps": {
      "allOf": [
        { "$ref": "#/$defs/paragraphCommonProps" },
        {
          "type": "object",
          "required": ["level"],
          "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 9 } }
        }
      ],
      "unevaluatedProperties": false
    },
    "sectionProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageSize": {
          "oneOf": [
            { "enum": ["A4", "Letter"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "orientation": { "enum": ["portrait", "landscape"] },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 },
            "header": { "type": "number", "minimum": 0 },
            "footer": { "type": "number", "minimum": 0 },
            "gutter": { "type": "number", "minimum": 0 }
          }
        },
        "titlePage": { "type": "boolean" },
        "textDirection": { "enum": ["lrTb", "tbRl", "btLr", "lrTbV", "tbRlV"] },
        "documentGrid": { "$ref": "#/$defs/documentGrid" },
        "pageNumbering": { "$ref": "#/$defs/pageNumbering" },
        "lineNumbering": { "$ref": "#/$defs/lineNumbering" },
        "columns": { "$ref": "#/$defs/sectionColumns" },
        "type": { "enum": ["nextPage", "nextColumn", "continuous", "evenPage", "oddPage"] }
      }
    },
    "documentGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["default", "lines", "linesAndChars", "snapToChars"] },
        "linePitch": { "type": "number", "exclusiveMinimum": 0 },
        "charSpace": { "type": "integer" }
      },
      "minProperties": 1
    },
    "pageNumbering": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "chapterStyle": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/pageNumberFormat" },
        "chapterSeparator": { "enum": ["hyphen", "period", "colon", "emDash", "enDash"] }
      }
    },
    "pageNumberFormat": {
      "enum": [
        "decimal", "upperRoman", "lowerRoman", "upperLetter", "lowerLetter", "ordinal", "cardinalText", "ordinalText", "hex", "chicago", "ideographDigital", "japaneseCounting", "aiueo", "iroha", "decimalFullWidth", "decimalHalfWidth", "japaneseLegal", "japaneseDigitalTenThousand", "decimalEnclosedCircle", "decimalFullWidth2", "aiueoFullWidth", "irohaFullWidth", "decimalZero", "bullet", "ganada", "chosung", "decimalEnclosedFullstop", "decimalEnclosedParen", "decimalEnclosedCircleChinese", "ideographEnclosedCircle", "ideographTraditional", "ideographZodiac", "ideographZodiacTraditional", "taiwaneseCounting", "ideographLegalTraditional", "taiwaneseCountingThousand", "taiwaneseDigital", "chineseCounting", "chineseLegalSimplified", "chineseCountingThousand", "koreanDigital", "koreanCounting", "koreanLegal", "koreanDigital2", "vietnameseCounting", "russianLower", "russianUpper", "numberInDash", "hebrew1", "hebrew2", "arabicAlpha", "arabicAbjad", "hindiVowels", "hindiConsonants", "hindiNumbers", "hindiCounting", "thaiLetters", "thaiNumbers", "thaiCounting", "none", "bahtText", "dollarText", "custom"
      ]
    },
    "lineNumbering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countBy": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 1 },
        "distance": { "type": "number", "minimum": 0 },
        "restart": { "enum": ["newPage", "newSection", "continuous"] }
      }
    },
    "sectionColumns": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 45 },
        { "$ref": "#/$defs/equalWidthColumns" },
        { "$ref": "#/$defs/sectionColumnWidths" }
      ]
    },
    "equalWidthColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 45 },
        "spacing": { "type": "number", "minimum": 0 },
        "separator": { "type": "boolean" }
      }
    },
    "sectionColumnWidths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widths"],
      "properties": {
        "widths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 45,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": { "type": "number", "minimum": 0 },
              "spacing": { "type": "number", "minimum": 0 }
            }
          }
        },
        "separator": { "type": "boolean" }
      }
    },
    "documentProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultFont": { "type": "string", "minLength": 1 },
        "defaultFonts": { "$ref": "#/$defs/fontSlots" },
        "defaultSize": { "type": "number", "exclusiveMinimum": 0 },
        "defaultCharacterSpacing": { "type": "number" },
        "defaultLineSpacing": { "$ref": "#/$defs/defaultLineSpacing" },
        "webExtensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/webExtension" }
        },
        "customXmlItems": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/customXmlItem" }
        },
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "lastModifiedBy": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "subject": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "documentProtection": { "$ref": "#/$defs/documentProtection" },
        "customProperties": { "$ref": "#/$defs/stringMap" },
        "documentId": { "type": "string", "minLength": 1 },
        "defaultTabStop": { "type": "number", "exclusiveMinimum": 0 },
        "zoom": { "type": "integer", "minimum": 10, "maximum": 500 },
        "documentVariables": { "$ref": "#/$defs/stringMap" },
        "evenAndOddHeaders": { "type": "boolean" },
        "trackRevisions": { "type": "boolean" },
        "doNotTrackMoves": { "type": "boolean" },
        "doNotTrackFormatting": { "type": "boolean" },
        "adjustLineHeightInTable": { "type": "boolean" },
        "characterSpacingControl": { "enum": ["doNotCompress", "compressPunctuation", "compressPunctuationAndJapaneseKana"] },
        "styles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/styleDefinition" }
        }
      },
      "allOf": [
        { "not": { "required": ["defaultFont", "defaultFonts"] } }
      ]
    },
    "defaultLineSpacing": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "before": { "type": "number", "minimum": 0 },
        "after": { "type": "number", "minimum": 0 },
        "line": { "type": "number", "minimum": 0 },
        "beforeLines": { "type": "integer", "minimum": 0 },
        "afterLines": { "type": "integer", "minimum": 0 },
        "lineRule": { "enum": ["auto", "atLeast", "exact"] }
      }
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string" }
    },
    "webExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "referenceId", "version", "store", "storeType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "referenceId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "store": { "type": "string", "minLength": 1 },
        "storeType": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "customXmlItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "xml"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "xml": { "type": "string", "minLength": 1 },
        "schemaRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "styleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["paragraph", "character", "numbering", "table"] },
        "basedOn": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 },
        "link": { "type": "string", "minLength": 1 },
        "quickFormat": { "type": "boolean" },
        "uiPriority": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "semiHidden": { "type": "boolean" },
        "unhideWhenUsed": { "type": "boolean" },
        "run": { "type": "object" },
        "paragraph": { "type": "object" },
        "table": { "type": "object" },
        "cell": { "type": "object" }
      }
    },
    "documentProtection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "edit": { "enum": ["none", "readOnly", "comments", "trackedChanges", "forms"] },
        "formatting": { "type": "boolean" },
        "enforcement": { "type": "boolean" },
        "cryptProviderType": { "enum": ["rsaFull", "rsaAES"] },
        "cryptAlgorithmClass": { "enum": ["hash", "encryption", "custom"] },
        "cryptAlgorithmType": { "enum": ["typeAny", "custom"] },
        "cryptAlgorithmSid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "cryptSpinCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "cryptProvider": { "type": "string", "minLength": 1 },
        "algIdExt": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" },
        "algIdExtSource": { "type": "string", "minLength": 1 },
        "cryptProviderTypeExt": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" },
        "cryptProviderTypeExtSource": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "salt": { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "algorithmName": { "type": "string", "minLength": 1 },
        "hashValue": { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "saltValue": { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "spinCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "allOf": [
        { "not": { "required": ["hash"], "not": { "required": ["salt"] } } },
        { "not": { "required": ["salt"], "not": { "required": ["hash"] } } },
        { "not": { "required": ["hashValue"], "not": { "required": ["saltValue"] } } },
        { "not": { "required": ["saltValue"], "not": { "required": ["hashValue"] } } }
      ]
    },
    "imageProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "width", "height"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "description": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "decorative": { "type": "boolean" },
        "relationshipId": { "type": "string", "minLength": 1 },
        "rotate": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "floating": { "type": "boolean" },
        "allowOverlap": { "type": "boolean" },
        "layoutInCell": { "type": "boolean" },
        "simplePosition": { "$ref": "#/$defs/simplePosition" },
        "positionH": {
          "oneOf": [
            { "type": "number" },
            { "enum": ["left", "center", "right"] }
          ]
        },
        "positionV": {
          "oneOf": [
            { "type": "number" },
            { "enum": ["top", "center", "bottom"] }
          ]
        },
        "relativeFromH": { "enum": ["character", "column", "insideMargin", "leftMargin", "margin", "outsideMargin", "page", "rightMargin"] },
        "relativeFromV": { "enum": ["bottomMargin", "insideMargin", "line", "margin", "outsideMargin", "page", "paragraph", "topMargin"] },
        "distanceTop": { "type": "number", "minimum": 0 },
        "distanceBottom": { "type": "number", "minimum": 0 },
        "distanceLeft": { "type": "number", "minimum": 0 },
        "distanceRight": { "type": "number", "minimum": 0 },
        "relativeHeight": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decorative": { "const": true } },
            "required": ["decorative"]
          },
          "then": {
            "not": { "anyOf": [{ "required": ["description"] }, { "required": ["title"] }] }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["allowOverlap"] },
              { "required": ["simplePosition"] },
              { "required": ["positionH"] },
              { "required": ["positionV"] },
              { "required": ["relativeFromH"] },
              { "required": ["relativeFromV"] },
              { "required": ["distanceTop"] },
              { "required": ["distanceBottom"] },
              { "required": ["distanceLeft"] },
              { "required": ["distanceRight"] },
              { "required": ["relativeHeight"] }
            ]
          },
          "then": {
            "properties": { "floating": { "const": true } },
            "required": ["floating"]
          }
        }
      ]
    },
    "simplePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "y": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    }
  }
}
